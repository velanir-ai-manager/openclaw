{
  "id": "velanir-llm-usage-reporter",
  "activation": {
    "onStartup": true
  },
  "name": "Velanir LLM Usage Reporter",
  "description": "Reports normalized OpenClaw llm_output token usage to the Velanir runtime observability API using runtime DPoP authentication.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "platform": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseUrl": {
            "type": "string",
            "minLength": 1
          },
          "endpointPath": {
            "type": "string",
            "default": "/v1/runtime/observability/llm-usage",
            "minLength": 1
          }
        }
      },
      "batch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxBatchSize": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 500
          },
          "maxQueueSize": {
            "type": "number",
            "default": 2000,
            "minimum": 1,
            "maximum": 10000
          },
          "flushIntervalMs": {
            "type": "number",
            "default": 5000,
            "minimum": 0,
            "maximum": 600000
          },
          "requestTimeoutMs": {
            "type": "number",
            "default": 10000,
            "minimum": 1000,
            "maximum": 60000
          }
        }
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "includeRawUsage": {
            "type": "boolean",
            "default": true
          },
          "includeContent": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "contracts": {
    "hooks": [
      "llm_output",
      "model_call_ended"
    ]
  },
  "uiHints": {
    "platform.baseUrl": {
      "label": "Platform API URL",
      "help": "Defaults to OCT8_API_URL from the runtime-v2 environment."
    },
    "metadata.includeContent": {
      "label": "Include Prompt/Output Content",
      "sensitive": true,
      "help": "Leave disabled for production cost attribution. Token/cost telemetry does not require prompts or assistant text."
    }
  }
}
